or:var(--ink-soft);border-top:1px dotted var(--line);padding-top:14px;margin-top:6px}\n\n  /* 使用步骤 */\n  .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}\n  .step-box{border:1.5px dashed var(--line);background:var(--ticket);padding:18px 18px 14px}\n  .step-box .num{font-size:12px;letter-spacing:.2em;color:var(--wine);display:block;margin-bottom:8px}\n  .step-box h3{font-size:16.5px;margin-bottom:8px;color:var(--wine-deep)}\n  .step-box p{font-size:14px;color:var(--ink-soft);margin:0}\n\n  .checklist{margin-top:24px;border:1.5px dashed var(--line);background:var(--ticket);padding:20px 24px}\n  .checklist h3{font-size:17px;color:var(--wine-deep);margin-bottom:10px}\n  .checklist ul{list-style:none;padding:0;margin:0}\n  .checklist li{font-size:14.5px;color:var(--ink-soft);padding-left:20px;position:relative}\n  .checklist li::before{content:\"—\";position:absolute;left:0;color:var(--wine)}\n\n  /* 客户端 */\n  .clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n  .client{border:1.5px dashed var(--line);background:var(--ticket);padding:18px 20px}\n  .client h3{font-size:16.5px;color:var(--wine-deep);margin-bottom:6px}\n  .client .os{font-size:12px;letter-spacing:.16em;color:#8d7565;display:block;margin-bottom:8px}\n  .client p{font-size:14px;color:var(--ink-soft);margin:0}\n  .clients-foot{margin-top:16px;font-size:13.5px;color:var(--ink-soft)}\n\n  /* FAQ 按主题分组 */\n  .faq-group{margin-bottom:32px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group h3{font-size:17px;color:var(--wine-deep);padding-bottom:8px;border-bottom:1px solid var(--line);margin-bottom:16px}\n  .qa{border:1.5px dashed var(--line);background:var(--ticket);padding:16px 20px;margin-bottom:12px}\n  .qa h4{font-size:15.5px;margin:0 0 6px;color:var(--wine);font-weight:700}\n  .qa p{font-size:14.5px;color:var(--ink-soft);margin:0}\n\n  footer{background:var(--wine-deep);color:#e8d9c6;padding:30px 0 34px}\n  footer .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:space-between;align-items:baseline}\n  footer p{margin:0;font-size:13.5px}\n  footer a{color:#f3e5cf;border-bottom:1px dotted rgba(243,229,207,.5)}\n  footer a:hover{color:#fff;border-bottom-color:#fff}\n  .footer-links{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:13.5px}\n\n  @media (max-width:820px){\n    .hero-grid{grid-template-columns:1fr;gap:26px}\n    .steps{grid-template-columns:1fr}\n    .clients{grid-template-columns:1fr}\n    .plan:nth-child(2),.plan:nth-child(3){margin-left:12px}\n  }\n  @media (max-width:520px){\n    .dash{grid-template-columns:1fr}\n    .plan:nth-child(2),.plan:nth-child(3){margin-left:0}\n    .plan{padding:18px 16px}\n    .price{margin-left:0;font-size:20px}\n    .checklist{padding:16px}\n  }\n</style><header class=\"masthead\">\n  <div class=\"wrap\">\n    <span class=\"brandmark\">柠檬 · SSLEMON</span>\n    <nav class=\"jump\" aria-label=\"页面内跳转\">\n      <a href=\"#plans\">套餐阶梯</a>\n      <a href=\"#how\">使用步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <div>\n          <h1 id=\"hero-title\">柠檬(ssLemon)</h1>\n          <p class=\"sub\">套餐 · 步骤 · 客户端 · 问答</p>\n          <p class=\"lede\"><strong>这一页只做四件事</strong>：把三档套餐的差异说清楚，把上手动作拆成可照着做的步骤，把客户端准备列成清单，把常见问题按主题归好。不铺垫形容词，能查到的写，查不到的标明“待确认”。</p>\n          <p class=\"lede\">价格与权益以本页正文为唯一依据。页面上没有写出的能力、节点、线路与服务承诺，不要默认它存在。</p>\n          <div class=\"note-strip\">阅读顺序建议：先看套餐对比，再看步骤，最后带着具体问题去 FAQ。遇到没覆盖的情况，按“先确认、再操作”的顺序处理。</div>\n        </div>\n\n        <div class=\"dash\" aria-label=\"页面信息速览\">\n          <div class=\"cell\">\n            <span class=\"k\">套餐档位</span>\n            <span class=\"v\">3 档</span>\n            <span class=\"n\">基础版 / 旗舰版 / 团队版，逐级递进</span>\n          </div>\n          <div class=\"cell\">\n            <span class=\"k\">起价</span>\n            <span class=\"v\">¥15<span>/月</span></span>\n            <span class=\"n\">基础版月付；年付口径见套餐区</span>\n          </div>\n          <div class=\"cell\">\n            <span class=\"k\">设备数</span>\n            <span class=\"v\">3 → 20 台</span>\n            <span class=\"n\">按档位递增，同时在线数</span>\n          </div>\n          <div class=\"cell\">\n            <span class=\"k\">问答分组</span>\n            <span class=\"v\">5 组</span>\n            <span class=\"n\">账号、套餐、设备、使用、售后</span>\n          </div>\n          <div class=\"cell wide\">\n            <span class=\"k\">本页不含</span>\n            <span class=\"v\">下载地址与支付链接</span>\n            <span class=\"n\">未确认来源，页面不提供跳转，统一以 # 占位</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2 id=\"plans-title\">套餐阶梯：从单人到多人</h2>\n        <span class=\"tag\">逐级递进</span>\n      </div>\n      <p class=\"lede\">三档之间的差别集中在三处：每月流量、同时在线设备数、可用节点与支持方式。先估自己的量，再选档，不必一步买到最高。</p>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <span class=\"step\">第 1 级</span>\n            <h3>基础版</h3>\n            <span class=\"price\">¥15<small>/月</small></span>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥150/年</p>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-top\">\n            <span class=\"step\">第 2 级</span>\n            <h3>旗舰版<span class=\"flag\">推荐</span></h3>\n            <span class=\"price\">¥35<small>/月</small></span>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥350/年</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <span class=\"step\">第 3 级</span>\n            <h3>团队版</h3>\n            <span class=\"price\">¥85<small>/月</small></span>\n          </div>\n          <p class=\"annual\">按年付仅需 ¥850/年</p>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"plans-foot\">说明：以上价格与权益均按本页列出内容执行，未列出的项目不作承诺。年付口径为“按年付”合计金额，是否支持中途变更档位，请以购买渠道的实际规则为准；本页不提供购买链接。</p>\n    </div>\n  </section>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2 id=\"how-title\">使用步骤：三步走完，再做检查</h2>\n        <span class=\"tag\">照着做</span>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step-box\">\n          <span class=\"num\">STEP 01</span>\n          <h3>先把账号与档位定下来</h3>\n          <p>确认要用的设备数量与每月用量，对照套餐阶梯选一档。设备多、要多人共用，就从旗舰版往上算。</p>\n        </div>\n        <div class=\"step-box\">\n          <span class=\"num\">STEP 02</span>\n          <h3>再准备客户端</h3>\n          <p>按系统选一个客户端，装好后再进入配置环节。不同系统可用的客户端不一样，先看下一节的清单。</p>\n        </div>\n        <div class=\"step-box\">\n          <span class=\"num\">STEP 03</span>\n          <h3>最后逐项验证</h3>\n          <p>配置完成后，先检查能否正常打开常用页面，再核对同时在线的设备数量是否超出所选档位。</p>\n        </div>\n      </div>\n\n      <div class=\"checklist\">\n        <h3>动手前的检查清单</h3>\n        <ul>\n          <li>数清家里或团队里需要同时在线的设备，别按“总设备数”估。</li>\n          <li>估一下每月大致用量，落在 100GB、300GB、1000GB 哪一档更接近。</li>\n          <li>确认系统：桌面端、移动端各自需要的客户端不同，分开装。</li>\n          <li>只从自己可信的渠道获取配置信息，不从陌生来源复制粘贴。</li>\n          <li>本页不提供下载地址与支付入口，任何来源不明的“安装包”都不要运行。</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2 id=\"clients-title\">客户端准备：按系统分开列</h2>\n        <span class=\"tag\">清单式</span>\n      </div>\n      <p class=\"lede\">下面只说明“在什么系统上准备什么”，不给出下载链接，也不声称兼容或性能表现。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"os\">WINDOWS</span>\n          <h3>桌面客户端</h3>\n          <p>在 Windows 电脑上准备一个可用客户端，装好后按界面提示进入配置环节。首次运行前先确认安装文件来源。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">MACOS</span>\n          <h3>桌面客户端</h3>\n          <p>macOS 端与 Windows 端分开处理，不要共用同一个安装文件。安装后留意系统权限提示，按提示逐项确认。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">ANDROID</span>\n          <h3>移动客户端</h3>\n          <p>安卓手机与平板按同一类处理，装好后先在一台设备上验证，再扩展到第二台，便于定位问题。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">IOS</span>\n          <h3>移动客户端</h3>\n          <p>iOS 设备从系统自带的应用渠道获取客户端，安装完成后按界面引导完成配置，不要跳过首次设置。</p>\n        </article>\n      </div>\n\n      <p class=\"clients-foot\">各客户端的具体名称与版本不在本页列出；本页不提供任何下载地址，也不对第三方客户端作兼容性承诺。若你的系统不在上述清单内，请先确认是否有可用客户端，再决定是否购买。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2 id=\"faq-title\">常见问题</h2>\n        <span class=\"tag\">按主题分组</span>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>一、账号与档位</h3>\n        <div class=\"qa\">\n          <h4>问：三档套餐到底差在哪？</h4>\n          <p>答：差在三个数字和两类资源。数字是每月流量、同时在线设备数、价格；资源是节点池与支持方式。基础版 100GB、3 台；旗舰版 300GB、5 台，并含流媒体解锁、IPLC 专线游戏加速优化与优先工单；团队版 1000GB、20 台，并含 VIP 高带宽节点、企业定制路由与专属客户经理。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>问：从基础版换到旗舰版，需要重新配置吗？</h4>\n          <p>答：档位变化主要影响可用资源与上限，与客户端安装本身是两件事。实际是否需要重新配置，取决于具体渠道的操作方式，本页不作承诺，建议先确认再动手。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>二、价格与年付</h3>\n        <div class=\"qa\">\n          <h4>问：年付是按什么算的？</h4>\n          <p>答：按本页列出，基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，对应的月付分别是 ¥15、¥35、¥85。年付合计算下来比按月支付更低，具体支付方式与规则以购买渠道为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>问：这一页能直接下单吗？</h4>\n          <p>答：不能。本页是说明页，不提供支付入口，也没有可点击的购买链接，页面内链接均为占位。价格信息仅用于帮助你比较档次。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>三、设备与同时在线</h3>\n        <div class=\"qa\">\n          <h4>问：“3 台同时在线”怎么理解？</h4>\n          <p>答：以同一时间处于在线状态的设备数为准，而不是一共装过几台。手机、平板、电脑都算设备。三档的上限分别是 3 台、5 台、20 台。超出上限时的处理方式本页不作说明，请以实际渠道规则为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>问：家里人多，应该选哪一档？</h4>\n          <p>答：先数同时使用的设备。两人各一部手机加一台电脑就已接近基础版上限，这种情况更适合旗舰版；若是有多人长期共用、或需要定制路由，再看团队版。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>四、使用与客户端</h3>\n        <div class=\"qa\">\n          <h4>问：为什么这一页没有下载链接？</h4>\n          <p>答：因为没有确认过的下载地址就不写出来，避免把你导向来源不明的安装包。本页只说明“在哪个系统上要准备客户端”，具体获取方式请以你信任的渠道为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>问：装了客户端但还是用不了，按什么顺序排查？</h4>\n          <p>答：第一步，确认同一台设备上的配置是否完整；第二步，把其他设备先断开，只留一台测试，排除同时在线数超额；第三步，换一个常用页面再试一次，判断是单点问题还是整体问题；第四步，仍未解决时整理现象描述，走对应档位的支持渠道。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>五、支持与信息边界</h3>\n        <div class=\"qa\">\n          <h4>问：各档的支持方式有什么不同？</h4>\n          <p>答：按本页列出，旗舰版含 7x24 优先工单支持，团队版含专属客户经理服务，基础版未单独列出支持方式。除此之外的支持细节，本页没有信息，不作补充。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>问：怎么判断这一页的信息能不能信？</h4>\n          <p>答：以本页正文为界。写出来的价格、流量、设备数、权益按原文理解；没写的性能、节点数量、覆盖范围、退款与日志政策，本页一律没有给出，请不要自行推定。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p>柠檬(ssLemon) · 说明页 · 价格与权益以本页正文为准</p>\n    <div class=\"footer-links\">\n      <a href=\"#plans\">套餐阶梯</a>\n      <a href=\"#how\">使用步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
